{
  "umbrella_project": "ai",
  "umbrella_chroot_arches": ["aarch64", "x86_64"],
  "chroot_exclude_distros": [
    "epel-7",
    "epel-8",
    "mageia",
    "rhel-7",
    "rhel-8",
    "centos-stream-8",
    "centos-stream+epel-next-8",
    "custom",
    "fedora-eln",
    "almalinux-kitten-10",
    "alma-kitten+epel-10",
    "openeuler",
    "opensuse-tumbleweed"
  ],
  "packages": [
    {
      "chroot_arches": ["aarch64", "x86_64"],
      "name": "gogcli",
      "project": "gogcli",
      "subdir": "packages/gogcli",
      "spec": "gogcli.spec",
      "upstream_url": "https://github.com/openclaw/gogcli.git",
      "tag_prefix": "v"
    },
    {
      "chroot_arches": ["aarch64", "x86_64"],
      "name": "wacli",
      "project": "wacli",
      "subdir": "packages/wacli",
      "spec": "wacli.spec",
      "upstream_url": "https://github.com/openclaw/wacli.git",
      "tag_prefix": "v",
      "exclude_distros": ["amazonlinux-2023", "fedora-43"]
    },
    {
      "chroot_arches": ["aarch64", "x86_64"],
      "name": "codex",
      "project": "codex",
      "subdir": "packages/codex",
      "spec": "codex.spec",
      "upstream_url": "https://github.com/openai/codex.git",
      "tag_prefix": "rust-v",
      "version_source": "github_release"
    },
    {
      "chroot_arches": ["aarch64", "x86_64"],
      "name": "opencode",
      "project": "opencode",
      "subdir": "packages/opencode",
      "spec": "opencode.spec",
      "upstream_url": "https://github.com/anomalyco/opencode.git",
      "tag_prefix": "v"
    },
    {
      "chroot_arches": ["aarch64", "x86_64"],
      "name": "ollama",
      "project": "ollama",
      "subdir": "packages/ollama",
      "spec": "ollama.spec",
      "upstream_url": "https://github.com/ollama/ollama.git",
      "tag_prefix": "v",
      "version_source": "github_release"
    },
    {
      "chroot_arches": ["aarch64", "x86_64"],
      "name": "claude-code",
      "project": "claude-code",
      "subdir": "packages/claude-code",
      "spec": "claude-code.spec",
      "npm_package": "@anthropic-ai/claude-code"
    },
    {
      "chroot_arches": ["aarch64", "x86_64"],
      "name": "composio",
      "project": "composio",
      "subdir": "packages/composio",
      "spec": "composio.spec",
      "upstream_url": "https://github.com/ComposioHQ/composio.git",
      "tag_prefix": "@composio/cli@"
    },
    {
      "chroot_arches": ["aarch64", "x86_64"],
      "name": "nodejs-latest",
      "project": "nodejs-latest",
      "subdir": "packages/nodejs-latest",
      "spec": "nodejs-latest.spec",
      "node_release": "current",
      "exclude_distros": ["opensuse-leap"]
    },
    {
      "chroot_arches": ["aarch64", "x86_64"],
      "name": "nodejs-lts",
      "project": "nodejs-lts",
      "subdir": "packages/nodejs-lts",
      "spec": "nodejs-lts.spec",
      "node_release": "lts",
      "exclude_distros": ["opensuse-leap"]
    }
  ]
}
